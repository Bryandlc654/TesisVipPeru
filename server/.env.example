# Puerto del servidor API
PORT=4000

# Entorno
NODE_ENV=development

# Conexión MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tesisvip

# Seguridad JWT
JWT_SECRET=cambia-esta-clave-por-una-muy-segura
JWT_EXPIRES_IN=8h

# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Credenciales iniciales del administrador (usadas por "npm run seed")
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tesis-vip.com
ADMIN_PASSWORD=Admin12345
